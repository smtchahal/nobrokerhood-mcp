# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# ── Identity ──────────────────────────────────────────────────────────────
# Found in the userId header of any app request
NBH_USER_ID=

# Found in the societyId header
NBH_SOCIETY_ID=

# Found in the deviceId header (UUID of your registered device)
NBH_DEVICE_ID=

# ── Auth cookies ──────────────────────────────────────────────────────────
# Capture these from a proxied app session (e.g. via mitmproxy or Charles Proxy)
NBH_REMEMBER_ME=
NBH_JSESSIONID=

# City identifier shown in cityId header (found in the same captured request)
NBH_CITY_ID=

# ── Optional ──────────────────────────────────────────────────────────────
# App version sent in appVersion header (default: 691)
NBH_APP_VERSION=691

# Audience city ID used by the jacket/home endpoint
# (found in typeToAudienceIdsMap.CITY in the app's jacket request)
NBH_CITY_AUDIENCE_ID=

# Optional analytics cookies present in captured app traffic
NBH_GA=
NBH_GA_SESSION=
NBH_GCL_AU=
